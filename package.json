{
  "name": "etendard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "knip": {
    "ignoreDependencies": [
      "@react-native-masked-view/masked-view",
      "expo-glass-effect",
      "expo-status-bar"
    ]
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "expo start",
    "build": "node scripts/check-content.ts && expo export --platform web --output-dir dist && node scripts/export-web.js dist",
    "build:natif": "expo export --platform ios --platform android --output-dir dist-natif",
    "check": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:infra": "node scripts/test-infra.js",
    "captures:maj": "node scripts/maj-captures.js",
    "captures:ci": "node scripts/captures-ci.js",
    "dragon:ecart": "node scripts/dragon-ecart.ts",
    "verify:fast": "pnpm check && pnpm lint && pnpm test",
    "verify": "pnpm verify:fast && pnpm test:infra && knip && depcruise src && pnpm build && html-validate \"dist/**/*.html\" && pnpm build:natif && pnpm test:e2e && html-validate \"dist-styleguide/styleguide/**/*.html\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
