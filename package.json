{
  "name": "etendard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check . && stylelint --allow-empty-input \"src/**/*.{astro,css}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:infra": "node scripts/test-infra.js",
    "captures:maj": "node scripts/maj-captures.js",
    "captures:ci": "node scripts/captures-ci.js",
    "verify:fast": "pnpm check && pnpm lint && pnpm test",
    "verify": "pnpm verify:fast && pnpm test:infra && knip && depcruise src && pnpm build && html-validate \"dist/**/*.html\" && pnpm test:e2e && html-validate \"dist-styleguide/styleguide/**/*.html\""
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.14.0",
    "html-validate": "11.18.0",
    "knip": "6.44.1",
    "postcss-html": "2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-order": "8.1.3",
    "stylelint-selector-bem-pattern": "5.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
