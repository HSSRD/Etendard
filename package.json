{
  "name": "etendard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "expo start",
    "build": "node scripts/check-content.ts && expo export --platform web --output-dir dist && node scripts/export-web.js dist",
    "check": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:infra": "node scripts/test-infra.js",
    "captures:maj": "node scripts/maj-captures.js",
    "captures:ci": "node scripts/captures-ci.js",
    "verify:fast": "pnpm check && pnpm lint && pnpm test",
    "verify": "pnpm verify:fast && pnpm test:infra && knip && depcruise src && pnpm build && html-validate \"dist/**/*.html\" && pnpm test:e2e && html-validate \"dist-styleguide/styleguide/**/*.html\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "html-validate": "11.18.0",
    "knip": "6.44.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
