# Étendard sur le Pi (ADR 0002). Installé dans /etc/caddy/Caddyfile par install.sh.
{
	# Aucune autre écoute que 127.0.0.1:8080 : ni API d'admin (:2019), ni HTTPS automatique (:80/:443).
	# Conséquence : appliquer un changement par « systemctl restart caddy » (reload passe par l'API d'admin).
	admin off
	auto_https off
}

http://:8080 {
	bind 127.0.0.1
	root * /srv/etendard/current
	file_server

	# En-têtes de sécurité, expliqués dans FONCTIONNEMENT.md. HSTS est posé par Cloudflare.
	# tests/csp.spec.ts (la CSP) et verify.sh (tous) les lisent ici : un par ligne, valeur entre guillemets.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
	}

	# Cache d'un an des fichiers d'Expo, dont le nom porte l'empreinte du contenu (#36, #76, FONCTIONNEMENT.md).
	# Sur les réponses 2xx et 304 seulement : une 404 ne doit pas rester en cache un an.
	header /_expo/static/* {
		Cache-Control "public, max-age=31536000, immutable"
		match status 2xx 304
	}

	# Pages sans extension (#106) : /projets/dragon/materiel sert materiel.html, /projets/dragon son
	# index.html, sans redirection. Dans route, try_files réécrit le chemin avant le matcher @html.
	route {
		try_files {path} {path}.html {path}/index.html

		# Pages HTML revalidées à chaque visite (ETag, réponse 304 légère) : après un déploiement,
		# un navigateur ne réutilise pas une ancienne page qui demanderait d'anciens /_expo/static/ (#52).
		@html path */ *.html
		header @html {
			Cache-Control "no-cache"
		}
	}

	# Jamais en cache : le test de fumée lit le SHA déployé à travers Cloudflare (ADR 0006).
	header /version.txt {
		Cache-Control "no-store"
	}

	# Adresse sans fichier : la page 404 d'Expo, avec le statut 404 (#114). Les en-têtes de sécurité,
	# posés avant l'erreur, restent sur la réponse ; pas le cache d'un an (réservé aux 2xx et 304).
	handle_errors 404 {
		rewrite * /+not-found.html
		# Sinon une revalidation (304) ou une plage (206) deviendrait une 404 vide ou tronquée.
		request_header -If-None-Match
		request_header -If-Modified-Since
		request_header -Range
		# Revalidée comme les pages HTML : @html a vu le chemin demandé, pas cette page.
		header Cache-Control "no-cache"
		file_server
	}

	# Journal d'accès JSON, 5 fichiers de 10 Mio au plus (le courant compris), anciens compressés.
	log {
		output file /var/log/caddy/etendard-access.log {
			roll_size 10MiB
			roll_keep 4
		}
		format json
	}
}
