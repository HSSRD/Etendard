---
// SiteHeader (ticket #11). Un seul rendu statique ; les états survol, focus et texte
// agrandi sont produits et capturés par SiteHeader.spec.ts. Les sections factices font
// chacune un écran pour tester le défilement vers #accueil et #projets sous le header.
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="SiteHeader — Styleguide — Étendard"
  description="Styleguide d’Étendard : en-tête collant et navigation par ancres."
>
  <meta slot="head" name="robots" content="noindex" />
  <SiteHeader slot="header" />
  <section id="accueil" class="site-header-demo">
    <h1>SiteHeader</h1>
  </section>
  <section id="projets" class="site-header-demo">
    <h2>Projets</h2>
  </section>
</BaseLayout>

<style>
  .site-header-demo {
    min-height: var(--min-height-below-header);
    padding: var(--space-6) var(--space-4);
  }
</style>
