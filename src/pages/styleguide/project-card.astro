---
// ProjectCard dans chacun de ses états (ticket #14) : présentation (intro), puis carte de sous-unité.
import { getEntries, getEntry } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const hussard = await getEntry('projects', 'hussard');
if (!hussard) throw new Error('Fiche hussard introuvable.');
const units = await getEntries(hussard.data.units ?? []);
const states = [
  { id: 'intro', label: 'Présentation (intro)', project: hussard, intro: true },
  ...units.map((project) => ({
    id: project.id,
    label: `Carte ${project.data.title}`,
    project,
    intro: false,
  })),
];
---

<BaseLayout
  title="ProjectCard — Styleguide — Étendard"
  description="Composant ProjectCard d’Étendard : la carte d’un projet."
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="styleguide-project-card">
    <h1>ProjectCard</h1>
    {states.map((state) => (
      <section
        class="styleguide-project-card__state"
        aria-labelledby={`etat-${state.id}`}
      >
        <h2 id={`etat-${state.id}`}>{state.label}</h2>
        <ProjectCard project={state.project} intro={state.intro} />
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .styleguide-project-card {
    display: grid;
    gap: var(--space-6);
    margin: 0 auto;
    max-width: var(--content-max-width);
    padding: var(--space-6) var(--space-4);
  }

  .styleguide-project-card__state {
    display: grid;
    gap: var(--space-4);
  }
</style>
