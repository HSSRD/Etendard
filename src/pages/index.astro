---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Étendard"
  description="Étendard, le site qui regroupe tous les projets de Hussard."
>
  <SiteHeader slot="header" />

  {/* Section d'accueil : Hero, ticket #13. Titre provisoire. */}
  <section id="accueil">
    <h1>Étendard</h1>
  </section>

  {/* Section projets : ProjectsSection, ticket #14. Titre provisoire. */}
  <section id="projets">
    <h2>Projets</h2>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
