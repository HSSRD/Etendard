---
// Bas de page du site (ticket #12), rendu dans l'emplacement « footer » de BaseLayout.
interface Props {
  /** Année du copyright ; par défaut celle du build. Figée sur le styleguide pour les captures. */
  year?: number;
}

const { year = new Date().getFullYear() } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__tagline">Étendard, la vitrine des projets HSSRD</p>
    <p>© {year} HSSRD</p>
    <p>
      <a href="https://github.com/HSSRD/Etendard" rel="noopener">
        Code source sur GitHub
      </a>
    </p>
    <p>
      <a href="#accueil">Retour en haut</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top-color: var(--color-border);
    border-top-style: solid;
    border-top-width: var(--border-width);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer__inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-inline: auto;
    max-width: var(--content-max-width);
    padding: var(--space-6) var(--space-4);
  }

  .site-footer__tagline {
    color: var(--color-text);
  }
</style>
