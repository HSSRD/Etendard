---
// Section « Projets » de la one page (ticket #14) : chaque projet racine (Hussard), puis une
// carte par sous-unité.
import { getProjects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

const groups = await getProjects();
---

<div class="projects-section">
  <h2>Projets</h2>
  {groups.map(({ root, units }) => (
    <div class="projects-section__group">
      <ProjectCard project={root} intro />
      {units.length > 0 && (
        <div class="projects-section__units">
          {units.map((unit) => (
            <ProjectCard project={unit} />
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .projects-section {
    display: grid;
    gap: var(--space-6);
    margin: 0 auto;
    max-width: var(--content-max-width);
    padding: var(--space-8) var(--space-4);
  }

  .projects-section__group {
    display: grid;
    gap: var(--space-6);
  }

  .projects-section__units {
    display: grid;
    gap: var(--space-5);
  }

  @media (width >= 768px) {
    .projects-section__units {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
