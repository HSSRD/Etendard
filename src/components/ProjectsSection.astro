---
// Section « Projets » de la one page (ticket #14) : Hussard, puis une carte par sous-unité.
import { getEntries, getEntry, render } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const hussard = await getEntry('projects', 'hussard');
if (!hussard)
  throw new Error('Fiche src/content/projects/hussard.md introuvable.');
const { Content } = await render(hussard);
const units = (await getEntries(hussard.data.units ?? [])).toSorted(
  (a, b) => a.data.order - b.data.order,
);
---

<div class="projects-section">
  <h2>Projets</h2>
  <div class="projects-section__intro">
    <h3>{hussard.data.title}</h3>
    <p class="projects-section__summary">{hussard.data.summary}</p>
    <Content />
  </div>
  <div class="projects-section__units">
    {units.map((unit) => (
      <ProjectCard project={unit} />
    ))}
  </div>
</div>

<style>
  .projects-section {
    display: grid;
    gap: var(--space-6);
    margin: 0 auto;
    max-width: var(--content-max-width);
    padding: var(--space-8) var(--space-4);
  }

  .projects-section__intro {
    display: grid;
    gap: var(--space-3);
  }

  .projects-section__summary {
    font-size: var(--font-size-lg);
  }

  .projects-section__units {
    display: grid;
    gap: var(--space-5);

    @media (width >= 768px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
