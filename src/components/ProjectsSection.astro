---
// Section « Projets » de la one page (ticket #14) : Hussard, puis une carte par sous-unité.
import { getProjects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';

const { root, units } = await getProjects();
---

<div class="projects-section">
  <h2>Projets</h2>
  <ProjectCard project={root} intro />
  <div class="projects-section__units">
    {units.map((unit) => (
      <ProjectCard project={unit} />
    ))}
  </div>
</div>

<style>
  .projects-section {
    display: grid;
    gap: var(--space-6);
    margin: 0 auto;
    max-width: var(--content-max-width);
    padding: var(--space-8) var(--space-4);
  }

  .projects-section__units {
    display: grid;
    gap: var(--space-5);

    @media (width >= 768px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
